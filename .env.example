BOT_TOKEN=replace_me
ADMIN_USER_ID=123456789
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./amazondealsbot.db
APP_TIMEZONE=Europe/Rome

# Amazon affiliate
AMAZON_PARTNER_TAG=example-21

# Provider: demo oppure creators
AMAZON_PROVIDER=demo
AMAZON_MARKETPLACE=www.amazon.it
AMAZON_SEARCH_KEYWORDS=offerta
AMAZON_SCAN_CATEGORIES_PER_RUN=4
AMAZON_SEARCH_ITEM_COUNT=10

# Creators API - lascia vuoto finché non hai accesso/credenziali
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_CREATORS_TIMEOUT_SECONDS=20
AMAZON_MIN_REQUEST_INTERVAL_SECONDS=1.05

# Shortlink proprietario opzionale
SHORTLINK_ENABLED=false
SHORTLINK_BASE_URL=

# Dashboard web opzionale
WEB_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ADMIN_TOKEN=

# AI opzionale
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_TIMEOUT_SECONDS=30

ADMIN_NOTIFICATIONS_ENABLED=true
BACKUP_DIR=./backups
